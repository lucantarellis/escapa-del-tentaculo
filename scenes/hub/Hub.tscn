[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/hub/hub.gd" id="1_hub"]
[ext_resource type="Resource" path="res://resources/configs/hub_config.tres" id="2_cfg"]
[ext_resource type="PackedScene" path="res://scenes/player/Player.tscn" id="3_player"]
[ext_resource type="PackedScene" path="res://scenes/ui/Market.tscn" id="4_market"]
[ext_resource type="PackedScene" path="res://scenes/ui/Settings.tscn" id="5_settings"]

[node name="Hub" type="Node2D"]
script = ExtResource("1_hub")
config = ExtResource("2_cfg")

[node name="Player" parent="." instance=ExtResource("3_player")]

[node name="Camera" type="Camera2D" parent="."]

[node name="Ui" type="CanvasLayer" parent="."]
layer = 90

[node name="Market" parent="Ui" instance=ExtResource("4_market")]

[node name="Settings" parent="Ui" instance=ExtResource("5_settings")]

[node name="Fade" type="ColorRect" parent="Ui"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 0)
